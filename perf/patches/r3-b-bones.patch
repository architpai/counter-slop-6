+/**
+ * A worn operator's skeleton, whose bone texture `OperatorAssets.send` uploads before a render's first pass. three
+ * updates a skinned mesh's bones once per render frame, but its frame count steps between listing the scene and the
+ * shadow maps, so the bones update again in the first cascade and their texture is uploaded there, at its first bind.
+ * While held, those updates are skipped: the bones' world matrices do not change inside a render, so the texture
+ * holds what they would have written. A skeleton without its texture yet (three makes it at the first bind) is not held.
+ */
+class OperatorSkeleton extends THREE.Skeleton {
+  /** Updated (by three's scene listing) since the last `release`. */
+  #fresh = false;
+  #held = false;
+
+  override update(): void {
+    if (this.#held) return;
+    super.update();
+    this.#fresh = true;
+  }
+
+  send(loaders: Pick<WeaponLoaders, 'upload'>): void {
+    const texture = this.boneTexture;
+    if (!texture) return;
+    // Culled from the camera this render: three would update it in a cascade that draws it.
+    if (!this.#fresh) super.update();
+    loaders.upload(texture);
+    this.#held = true;
+  }
+
+  release(): void {
+    this.#held = this.#fresh = false;
+  }
