+/**
+ * The canvas's WebGL2 context: three's attributes (`WebGLRenderer` asks for `alpha: true` whatever it is told), but
+ * opaque, so the compositor draws the canvas without blending it over the page. Exact: every frame's last pass
+ * writes every canvas pixel with alpha 1 (postfx.ts: Low's `_low`, the realistic `_final`, or SMAA's blend of an
+ * alpha-1 `_ldr`), and a bare canvas shows the page's colour (`Renderer._clearToPage`), as the transparent one did.
+ */
+function opaqueContext(canvas: HTMLCanvasElement): WebGL2RenderingContext {
+  const gl = canvas.getContext('webgl2', {
+    alpha: false, depth: false, stencil: false, antialias: false, premultipliedAlpha: true,
+    preserveDrawingBuffer: false, powerPreference: 'high-performance', failIfMajorPerformanceCaveat: false,
+  });
+  if (gl) return gl;
+  // three's messages for the same failures.
+  throw new Error(canvas.getContext('webgl2') ? 'Error creating WebGL context with your selected attributes.' : 'Error creating WebGL context.');
+}
+
+/**
+ * The page's colour behind the canvas (globals.css `html, body`), which a transparent bare canvas showed, as the
+ * canvas's clear values; null if it is not an opaque `rgb()`. The canvas stores bytes as written (sRGB, as the final
+ * passes encode), and a quarter step above each byte gives that byte whether the GPU rounds or truncates.
+ */
+function pageColour(canvas: HTMLCanvasElement): [number, number, number] | null {
+  const body = canvas.ownerDocument.body;
+  const m = body ? /^rgba?\((\d+), (\d+), (\d+)(?:, ([\d.]+))?\)$/.exec(getComputedStyle(body).backgroundColor) : null;
+  if (!m || (m[4] !== undefined && Number(m[4]) !== 1)) return null;
+  return [1, 2, 3].map(i => (Number(m[i]) + 0.25) / 255) as [number, number, number];
+}
