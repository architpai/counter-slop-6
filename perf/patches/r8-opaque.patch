diff --git a/tests/opaque-canvas.test.ts b/tests/opaque-canvas.test.ts
new file mode 100644
index 0000000..2ddf766
--- /dev/null
+++ b/tests/opaque-canvas.test.ts
@@ -0,0 +1,84 @@
+import { afterEach, expect, test } from 'vitest';
+import { Renderer } from '@/engine/render/index';
+import { PRESET_VALUES } from '@/engine/render/quality';
+import type { GfxValues } from '@/engine/render/quality';
+
+const fx = { hurt: 0, flash: 0, slow: 0, lowHp: 0 };
+const cleanup: (() => void)[] = [];
+afterEach(() => { for (const fn of cleanup.splice(0)) fn(); });
+
+function make(canvas = document.createElement('canvas')): Renderer {
+  canvas.width = canvas.height = 64;
+  const renderer = new Renderer(canvas);
+  cleanup.push(() => renderer.dispose());
+  return renderer;
+}
+
+/** The canvas's bytes, read in the same task as the draw (the buffer is not yet presented and cleared). */
+function canvasBytes(renderer: Renderer): Uint8Array {
+  const gl = renderer.three.getContext() as WebGL2RenderingContext;
+  const { width, height } = gl.canvas;
+  const bytes = new Uint8Array(width * height * 4);
+  const read = gl.getParameter(gl.READ_FRAMEBUFFER_BINDING) as WebGLFramebuffer | null;
+  gl.bindFramebuffer(gl.READ_FRAMEBUFFER, null);
+  gl.readPixels(0, 0, width, height, gl.RGBA, gl.UNSIGNED_BYTE, bytes);
+  gl.bindFramebuffer(gl.READ_FRAMEBUFFER, read);
+  return bytes;
+}
+
+test('the canvas context is three\'s, but opaque', () => {
+  const renderer = make();
+  const attributes = renderer.three.getContext().getContextAttributes()!;
+  expect({ ...attributes }).toMatchObject({ alpha: false, depth: false, stencil: false, antialias: false, premultipliedAlpha: true,
+    preserveDrawingBuffer: false, powerPreference: 'high-performance', failIfMajorPerformanceCaveat: false });
+  // three's own clear alpha (from the context's `alpha`, as from its default `alpha: false` before) is unchanged.
+  expect(renderer.three.getClearAlpha()).toBe(1);
+});
+
+test('every frame writes every canvas pixel with alpha 1 on every preset and on a flat look with SMAA to the canvas', () => {
+  // A transparent context made first, as three made it: the renderer takes it, and its alpha shows each frame's writes.
+  const canvas = document.createElement('canvas');
+  canvas.getContext('webgl2', { alpha: true, depth: false, stencil: false, antialias: false, premultipliedAlpha: true, powerPreference: 'high-performance' });
+  const renderer = make(canvas);
+  expect(renderer.three.getContext().getContextAttributes()!.alpha).toBe(true);
+  const looks: [string, GfxValues][] = [
+    ...(['low', 'medium', 'high', 'ultra'] as const).map(name => [name, PRESET_VALUES[name]] as [string, GfxValues]),
+    ['flat + smaa', { ...PRESET_VALUES.low, antialias: 'smaa' }],
+  ];
+  for (const [name, values] of looks) {
+    renderer.applyQuality(values);
+    for (let i = 0; i < 2; i++) renderer.render(i, fx);
+    const bytes = canvasBytes(renderer);
+    let transparent = 0;
+    for (let i = 3; i < bytes.length; i += 4) if (bytes[i] !== 255) transparent++;
+    expect(transparent, name).toBe(0);
+  }
+}, 60_000);
+
+test('a bare canvas shows the page\'s colour, and three\'s GL state is left as it was', () => {
+  const was = document.body.style.background;
+  document.body.style.background = 'rgb(17, 28, 37)';
+  cleanup.push(() => { document.body.style.background = was; });
+  const renderer = make();
+  const gl = renderer.three.getContext() as WebGL2RenderingContext;
+  const page = (bytes: Uint8Array) => bytes.every((b, i) => b === [17, 28, 37, 255][i % 4]);
+  expect(page(canvasBytes(renderer))).toBe(true);
+  renderer.render(0, fx);
+  expect(page(canvasBytes(renderer))).toBe(false);
+  // A resize resets the buffer; the page's colour is back, and the clear colour, masks, scissor and target are kept.
+  renderer.three.setRenderTarget(renderer.post.target);
+  gl.clearColor(0.1, 0.2, 0.3, 0.4);
+  gl.colorMask(true, false, true, false);
+  gl.enable(gl.SCISSOR_TEST);
+  const state = () => [[...gl.getParameter(gl.COLOR_CLEAR_VALUE)], gl.getParameter(gl.COLOR_WRITEMASK), gl.isEnabled(gl.SCISSOR_TEST),
+    gl.getParameter(gl.DRAW_FRAMEBUFFER_BINDING), gl.getParameter(gl.READ_FRAMEBUFFER_BINDING)];
+  const before = state();
+  renderer.resize();
+  expect(state()).toEqual(before);
+  gl.colorMask(true, true, true, true);
+  gl.disable(gl.SCISSOR_TEST);
+  expect(page(canvasBytes(renderer))).toBe(true);
+  // No page colour to show (a transparent page): nothing is cleared.
+  document.body.style.background = 'transparent';
+  expect(make()._page).toBeNull();
+}, 60_000);
