+import { TYPES } from '@/engine/enemies/types';
+import type { EnemyKind } from '@/engine/types';
+
+/**
+ * `OperatorBody.sync` reads the clips through a kind's bone-indexed binding and a per-figure list of the clips
+ * playing (Round 8 of perf/LOG.md), writes each bone's quaternion once, and the support hand's reach computes only
+ * the world matrices it reads. The reference below is the code it replaced (by-name lookups per bone and clip, the
+ * whole-armature update and `getWorld*` reads of the reach), kept verbatim: both must give every bone the same
+ * position, quaternion, Euler rotation and scale to the bit, from the same interpolant calls with the same times in
+ * the same order, and after three's scene walk every node under the figure the same matrices and every skinned mesh
+ * the same bone matrices.
+ */
+
+const loaders = {
+  model: (url: string) => new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).loadAsync(url),
+  texture: async (url: string): Promise<Texture> => {
+    const texture = new DataTexture(new Uint8Array(4), 1, 1);
+    texture.name = url;
+    return texture;
+  },
+  upload: () => {},
+};
+
+async function stream(assets: OperatorAssets): Promise<void> {
+  for (let i = 0; i < 3000; i++) {
+    assets.pump();
+    if (!assets.pending) return;
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  throw new Error('timed out waiting for the operators to stream');
+}
+
+const LOOP_NAMES = new Set(Object.entries(OPERATOR_MANIFEST.clips).filter(([, clip]) => clip.loop).map(([name]) => name));
+const GROUPS = ['humanoid', 'machine', 'drone'] as const;
+
