+  out.identity();
+  for (const name of LOOPS) {
+    const weight = motion.weights[name];
+    if (weight < 0.01) continue;
+    const clip = library.get(motion.group, name);
+    const track = clip?.tracks.get(bone);
+    if (!clip || !track) continue;
