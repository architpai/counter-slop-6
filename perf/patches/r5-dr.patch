+test('the rig sets its depth slice once per run of rig draws, and every draw still gets the range it had', async () => {
+  const renderer = makeRenderer();
+  const gl = renderer.three.getContext(), range = vi.spyOn(gl, 'depthRange');
+  const seen: [string, number][] = [];
+  const material = (name: string, transparent = false): THREE.Material => {
+    const made = new THREE.MeshBasicMaterial({ transparent });
+    made.name = name;
+    made.onBeforeRender = () => { seen.push([name, range.mock.calls.at(-1)?.[1] ?? 1]); };
+    return made;
+  };
+  // Two opaque rig meshes (one drawn per group), a transparent one, and the world's draws around them.
+  const gun = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.1, 0.4), material('rig'));
+  const sights = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.05, 0.05), Array.from({ length: 6 }, () => material('rig')));
+  const glint = new THREE.Mesh(new THREE.PlaneGeometry(0.1, 0.1), material('rig', true));
+  for (const [i, mesh] of [gun, sights, glint].entries()) {
+    mesh.position.set(0.1 * i, -0.2, -0.5);
+    renderer.rig.add(mesh);
+    renderer.prepareRig(mesh);
+  }
+  const wall = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), material('world'));
+  wall.position.z = -3;
+  const smoke = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material('world', true));
+  smoke.position.z = -2;
+  renderer.scene.add(wall, smoke);
+  renderer.camera.position.set(0, 0, 0);
+  for (let i = 0; i < 100 && (i < 2 || renderer._compiles.length + renderer._warmups.length > 0); i++) {
+    renderer.render(0, fx);
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  range.mockClear();
+  seen.length = 0;
+  renderer.render(0, fx);
+  expect(seen.filter(([name]) => name === 'rig')).toHaveLength(8);
+  for (const [name, far] of seen) expect(far, name).toBe(name === 'rig' ? RIG_DEPTH : 1);
+  expect(range.mock.calls).toEqual([[0, RIG_DEPTH], [0, 1], [0, RIG_DEPTH], [0, 1]]);
+}, 60_000);
+
