+
+test('in a live match a held warm-up never shares a frame with an upload slot or a sky step: it goes first on the next', async () => {
+  const canvas = document.createElement('canvas');
+  document.body.append(canvas);
+  const renderer = new Renderer(canvas);
+  const fx = { hurt: 0, flash: 0, slow: 0, lowHp: 0 };
+  // A stream that takes every slot open to it, as the level's textures do while they come in.
+  const uploads: number[] = [];
+  vi.spyOn(renderer, '_streamTextures').mockImplementation(() => {
+    const now = performance.now();
+    if (now < renderer._uploadAt || renderer._match.quiet(now)) return;
+    uploads.push(renderer._frame);
+    renderer._uploadAt = now + 24;
+  });
+  const drawn: number[] = [];
+  const template = new THREE.Mesh(new THREE.BoxGeometry(), new THREE.MeshLambertMaterial());
+  template.onBeforeRender = () => { drawn.push(renderer._frame); };
+  // A glb's warm-up, held (its programs linked) while the quiet start ran out.
+  renderer.setLive(true);
+  const warmed = renderer._hold(renderer._warmups, template, () => true, true);
+  renderer.render(0, fx);
+  expect([drawn, uploads], 'nothing in the quiet start').toEqual([[], []]);
+  renderer._match.set(false, 0);
+  renderer._match.set(true, performance.now() - MATCH_QUIET_MS);
+  const first = renderer._frame + 1;
+  for (let i = 0; i < 4; i++) {
+    // The slot open at every frame's start.
+    renderer._uploadAt = 0;
+    renderer.render(0, fx);
+  }
+  // The upload takes the first frame; the next is kept for the warm-up (no upload); then the uploads go on.
+  expect(drawn).toEqual([first + 1]);
+  expect(uploads).toEqual([first, first + 2, first + 3]);
+  await warmed;
+  expect([renderer._heldWait, renderer._uploadAt < Infinity]).toEqual([false, true]);
+  // At a menu nothing waits: the warm-up draws on a frame that uploads too.
+  renderer.setLive(false);
+  drawn.length = uploads.length = 0;
+  void renderer._hold(renderer._warmups, template, () => true, true);
+  renderer._uploadAt = 0;
+  renderer.render(0, fx);
+  expect([drawn, uploads]).toEqual([[renderer._frame], [renderer._frame]]);
+  renderer.dispose();
+  canvas.remove();
+}, 60_000);
