+    const scene = new Scene(), world = new World();
+    const level = buildLevel(scene, world, key, { arena: false });
+    try {
+      const rand = mulberry32(key.length * 977);
+      const nav = new NavGrid(world, level.bounds), bossNav = new NavGrid(world, level.bounds, 1, BOSS_CLEARANCE, BOSS_HEADROOM);
+      nav.build(); bossNav.build();
+      const walker = compare(nav, rand, level.bounds, 150);
+      expect(walker.found).toBeGreaterThan(20);
+      compare(bossNav, rand, level.bounds, 40);
+    } finally { disposeLevel(scene, level); world.clear(); }
+  }
+});
