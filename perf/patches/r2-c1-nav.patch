diff --git a/tests/nav-heap.test.ts b/tests/nav-heap.test.ts
new file mode 100644
index 0000000..2b9663a
--- /dev/null
+++ b/tests/nav-heap.test.ts
@@ -0,0 +1,148 @@
+import { expect, test } from 'vitest';
+import { Scene, Vector3 } from 'three';
+import { buildLevel, disposeLevel } from '@/engine/level';
+import { World } from '@/engine/physics';
+import { BOSS_CLEARANCE, BOSS_HEADROOM, NavGrid } from '@/engine/nav';
+
+// The A* that `NavGrid.findPath` replaced (object heap items, heuristic closure), kept as the reference: the
+// typed-array heap must pop in the same order, so every path must come out bit-identical.
+interface HeapItem { id: number; f: number }
+function pushHeap(heap: HeapItem[], item: HeapItem) {
+  let i = heap.length;
+  heap.push(item);
+  while (i > 0) {
+    const parent = (i - 1) >> 1;
+    const above = heap[parent];
+    if (above === undefined || above.f <= item.f) break;
+    heap[i] = above;
+    i = parent;
+  }
+  heap[i] = item;
+}
+function popHeap(heap: HeapItem[]): HeapItem | undefined {
+  const first = heap[0], last = heap.pop();
+  if (!heap.length || last === undefined) return first;
+  let i = 0;
+  while (i * 2 + 1 < heap.length) {
+    let child = i * 2 + 1;
+    let best = heap[child];
+    const right = heap[child + 1];
+    if (right !== undefined && best !== undefined && right.f < best.f) { child++; best = right; }
+    if (best === undefined || last.f <= best.f) break;
+    heap[i] = best;
+    i = child;
+  }
+  heap[i] = last;
+  return first;
+}
+function referencePath(grid: NavGrid, from: Vector3, to: Vector3, maxExpand = 40000) {
+  const nodes = grid.nodes, start = grid.nearest(from, 3, 3), goal = grid.nearest(to, 4, 8);
+  if (start < 0 || goal < 0) return null;
+  const target = nodes[goal];
+  if (target === undefined) return null;
+  const g = new Float64Array(nodes.length), parents = new Int32Array(nodes.length);
+  const reached = new Uint8Array(nodes.length), closed = new Uint8Array(nodes.length);
+  const heuristic = (id: number) => {
+    const node = nodes[id];
+    if (node === undefined) return Infinity;
+    return 1.15 * Math.hypot(node.x - target.x, node.y - target.y, node.z - target.z);
+  };
+  let best = start, bestH = heuristic(start), complete = false, expanded = 0;
+  reached[start] = 1; g[start] = 0; parents[start] = -1;
+  const open: HeapItem[] = [];
+  pushHeap(open, { id: start, f: bestH });
+  while (open.length) {
+    const top = popHeap(open);
+    if (top === undefined) break;
+    const cur = top.id;
+    if (closed[cur]) continue;
+    closed[cur] = 1;
+    if (cur === goal) { best = cur; complete = true; break; }
+    if (++expanded > maxExpand) break;
+    const h = heuristic(cur);
+    if (h < bestH) { best = cur; bestH = h; }
+    const node = nodes[cur];
+    if (node === undefined) continue;
+    for (const link of node.links) {
+      const next = link.to, cost = (g[cur] ?? 0) + link.cost;
+      if (!reached[next] || cost < (g[next] ?? 0)) {
+        reached[next] = 1; g[next] = cost; parents[next] = cur;
+        pushHeap(open, { id: next, f: cost + heuristic(next) });
+      }
+    }
+  }
+  const path: Vector3[] = [];
+  for (let id = best; id >= 0; id = parents[id] ?? -1) {
+    const node = nodes[id];
+    if (node === undefined) break;
+    path.push(new Vector3(node.x, node.y, node.z));
+  }
+  return { path: path.reverse(), complete };
+}
+
+function mulberry32(seed: number) {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function compare(grid: NavGrid, rand: () => number, bounds: { minX: number; maxX: number; minZ: number; maxZ: number }, count: number) {
+  const pick = () => {
+    const node = grid.nodes[Math.floor(rand() * grid.nodes.length)];
+    if (node && rand() < 0.7) return new Vector3(node.x + rand() - 0.5, node.y + rand() * 0.5, node.z + rand() - 0.5);
+    return new Vector3(bounds.minX + rand() * (bounds.maxX - bounds.minX), rand() * 8, bounds.minZ + rand() * (bounds.maxZ - bounds.minZ));
+  };
+  const caps = [40000, 4000, 1000, 50, 0];
+  let found = 0, partial = 0;
+  for (let k = 0; k < count; k++) {
+    const from = pick(), to = pick(), cap = caps[k % caps.length]!;
+    const want = referencePath(grid, from, to, cap), got = grid.findPath(from, to, cap);
+    expect(got === null).toBe(want === null);
+    if (!got || !want) continue;
+    expect(got.complete).toBe(want.complete);
+    expect(got.length).toBe(want.path.length);
+    for (let i = 0; i < got.length; i++) {
+      const a = got[i]!, b = want.path[i]!;
+      expect(Object.is(a.x, b.x) && Object.is(a.y, b.y) && Object.is(a.z, b.z)).toBe(true);
+    }
+    if (got.complete) found++; else partial++;
+  }
+  return { found, partial };
+}
+
+test('typed-array A* returns the same paths as the object-heap reference (synthetic tiers)', () => {
+  const rand = mulberry32(1234), world = new World(), v = (x: number, y: number, z: number) => new Vector3(x, y, z);
+  const bounds = { minX: -30, maxX: 30, minZ: -30, maxZ: 30 };
+  world.addBox(v(-30, -1, -30), v(30, 0, 30));
+  for (let i = 0; i < 70; i++) {
+    const x = -28 + rand() * 54, z = -28 + rand() * 54, w = 0.3 + rand() * 6, d = 0.3 + rand() * 6;
+    const h = rand() < 0.4 ? 0.3 + rand() * 1.2 : 2 + rand() * 4;
+    world.addBox(v(x, 0, z), v(x + w, h, z + d));
+  }
+  for (let i = 0; i < 8; i++) world.addBox(v(-20 + i * 2, 0, 10), v(-18 + i * 2, 0.4 * (i + 1), 14)); // stairs
+  world.finalize();
+  const grid = new NavGrid(world, bounds); grid.build();
+  expect(grid.nodes.length).toBeGreaterThan(1000);
+  const { found, partial } = compare(grid, rand, bounds, 400);
+  expect(found).toBeGreaterThan(50);
+  expect(partial).toBeGreaterThan(20);
+  world.clear();
+});
+
