+/** Ranges a ring-buffer attribute keeps before it uploads whole (a pool written for long while it is not drawn). */
+const MAX_RANGES = 32;
+
+/**
+ * Upload `count` floats from `start` with the next draw: the slot a
+ * ring-buffer pool just wrote. Every write to such an attribute must be
+ * marked (three uploads only the ranges listed), so the GPU's copy matches
+ * the array at every draw, as a whole upload would. Touching or overlapping
+ * the last range extends it.
+ */
+export function markSlots(attribute: THREE.BufferAttribute, start: number, count: number): void {
+  const ranges = attribute.updateRanges, last = ranges[ranges.length - 1];
+  if (last && start >= last.start && start <= last.start + last.count) last.count = Math.max(last.count, start + count - last.start);
+  else if (ranges.length >= MAX_RANGES) {
+    attribute.clearUpdateRanges();
+    attribute.addUpdateRange(0, attribute.array.length);
+  } else attribute.addUpdateRange(start, count);
+  attribute.needsUpdate = true;
+}
