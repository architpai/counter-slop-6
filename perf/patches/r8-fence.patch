diff --git a/src/engine/render/index.ts b/src/engine/render/index.ts
index 4640fbf..acca115 100644
--- a/src/engine/render/index.ts
+++ b/src/engine/render/index.ts
@@ -1794,8 +1794,11 @@ export class Renderer {
       this.post.drawSoft(this.three, this.fxScene, this.camera);
     }
     this.post.draw(this.three, time, fx, this.camera);
-    // Only the realistic look streams (`gpuBehind`), so only its frames put a fence (a sync object each).
-    if (this._quality.look === 'realistic') this._fences.mark(performance.now());
+    // Only `gpuBehind` reads the fences, and only while something streams (only the realistic look does): a frame puts
+    // one (a sync object, a GPU query and a main-thread task for its status) only then, and the ring is let go when
+    // the stream ends. A new stream starts with an empty ring, which reads "not behind", as a drained one does.
+    if (!this.streaming) this._fences.clear();
+    else if (this._quality.look === 'realistic') this._fences.mark(performance.now());
   }
 }
 
diff --git a/tests/pacing.test.ts b/tests/pacing.test.ts
