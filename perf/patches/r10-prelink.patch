+import { OPERATOR_AO, levelDepthMat, levelDepthSkinnedMat, levelDepthTwin, operatorMaterial, operatorTwin, quietly, twinMaterial, wearMaps } from './materials';
 import { ClipLibrary, LOOPS, ONE_SHOTS, type ClipGroup, type OperatorMotion } from './operator-motion';
 import { ANISOTROPY, TEXTURE_MAPS, TEXTURE_SIZE } from './surfaces';
 import { textureBytes } from './textures';
@@ -108,6 +108,52 @@ export function disposeSkinnedDepthProbe(probe: THREE.SkinnedMesh): void {
   probe.skeleton.dispose();
