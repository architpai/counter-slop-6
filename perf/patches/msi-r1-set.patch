+  input: MotionInput;
+  dt: number;
+  melee: number | null;
+  /** The frame it dies from (STILL), and the frame a limb is torn off (-1: never). */
+  dies: number;
+  tears: number;
+  torn: string;
+  hidden: Object3D | null;
+  returns: (() => void)[];
+  /** What the run reached, for the coverage checks: frames with the support hand's reach (and at a weight under 1), with a folded bone. */
+  reached: number;
+  partial: number;
+  folded: number;
+}
+
+/** The one-shots seen in flight on a frame a body synced. */
+const shotsSeen = new Set<string>();
+
+const material = new MeshStandardMaterial();
+
+function subject(assets: OperatorAssets, kind: string, seed: number): Subject {
+  const figure = figureOf(kind), rig = figure.rig!, template = assets.kind(rig.kind)!;
+  const body = new OperatorBody(rig, template, () => template.meshes.map(() => material));
+  const rand = mulberry32(seed);
+  const carry = CARRIES[seed % CARRIES.length]!;
+  const limbs = ['head', 'upperL', 'foreR', 'thighL', 'wingL', 'torso'].filter(name => figure.parts[name as keyof typeof figure.parts]);
+  return {
+    kind, figure, body, rand, dt: 1 / 60, melee: null, hidden: null, returns: [], reached: 0, partial: 0, folded: 0,
+    input: { speed: 0, phase: 0, lateral: 0, aim: 0, carry, onGround: true, crouch: false, flinch: 0, melee: null },
+    dies: seed % 3 === 0 ? 200 + (seed % 50) : -1,
+    tears: seed % 4 === 1 ? 100 + (seed % 70) : -1,
+    torn: limbs[seed % limbs.length] ?? 'head',
+  };
+}
+
+/** One step of a figure's owner: speeds, sideways motion, crouch, aim, carry, jumps, shots, reloads, hits, throws, melee, death. */
+function drive(s: Subject, frame: number): void {
+  const { rand, input, figure } = s, motion = s.figure.rig!.motion;
+  if (frame % 60 === 0) s.dt = [1 / 60, 1 / 60, 1 / 30, 1 / 144, 1 / 20][Math.floor(rand() * 5)]!;
+  if (rand() < 0.02) input.speed = [0, 0, 0.1, 0.8, 1.2, 3, 4.2, 5, 6.2, 8][Math.floor(rand() * 10)]!;
+  if (rand() < 0.02) input.lateral = [0, 0, 0.3, -0.3, 1, -1, rand() * 2 - 1][Math.floor(rand() * 7)]!;
+  if (rand() < 0.01) input.crouch = !input.crouch;
+  if (rand() < 0.02) input.aim = [0, 1, 1, 0.5, rand()][Math.floor(rand() * 5)]!;
+  if (rand() < 0.003) input.carry = CARRIES[Math.floor(rand() * 4)]!;
+  input.onGround = !(rand() < 0.01) && (input.onGround || rand() < 0.1);
+  input.phase += input.speed * s.dt * 4;
+  input.flinch = Math.max(0, input.flinch - s.dt * 3);
+  if (rand() < 0.04) motion.trigger('fire');
+  if (rand() < 0.006) motion.trigger('reload');
+  if (rand() < 0.01) { motion.trigger('hit'); input.flinch = 1; }
+  if (rand() < 0.005) motion.trigger('throw');
+  if (s.melee === null && rand() < 0.006) s.melee = 0;
+  if (s.melee !== null) {
+    s.melee += s.dt / 0.55;
+    if (s.melee > 1) s.melee = null;
+  }
+  input.melee = s.melee;
+  const dead = s.dies >= 0 && frame >= s.dies;
+  motion.update(s.dt, dead ? STILL : input);
+  // Weights and shots at the edges of the skip and slerp tests.
+  if (frame % 37 === 5) {
+    const name = LOOPS[Math.floor(rand() * LOOPS.length)]!;
+    motion.weights[name] = [0.01, 0.0099999, 1, 0.999, 0.9989, 0, -0.001, 1.2][Math.floor(rand() * 8)]!;
+    const shot = motion.shots.get(ONE_SHOTS[Math.floor(rand() * ONE_SHOTS.length)]!);
+    if (shot) shot.weight = [1.5, 1, 0.999, 0.9989, 0.5, 0.001][Math.floor(rand() * 6)]!;
+  }
+  // The pivots, as the owner turns them; one hidden for a while; a limb torn off.
+  for (const source of s.body.sources) {
+    if (!source || rand() < 0.3) continue;
+    source.rotation.set((rand() - 0.5) * 1.2, (rand() - 0.5) * 1.2, (rand() - 0.5) * 0.6);
+    if (rand() < 0.05) source.scale.setScalar(0.5 + rand());
+  }
+  if (frame % 150 === 40 && !s.hidden) {
+    const sources = s.body.sources.filter((source): source is Object3D => source !== null);
+    s.hidden = sources[Math.floor(rand() * sources.length)] ?? null;
+    if (s.hidden) s.hidden.visible = false;
+  } else if (frame % 150 === 90 && s.hidden) {
+    s.hidden.visible = true;
+    s.hidden = null;
+  }
+  if (frame === s.tears) {
+    const part = figure.parts[s.torn as keyof typeof figure.parts];
+    if (part && part.parent) {
+      new Group().attach(part);
+      s.returns.push(figure.lend(part));
+    }
+  }
+}
+
+/**
+ * Drive every subject `frames` frames; each frame, figure by figure as `OperatorAssets.frame` does, the reference
+ * syncs it on `ref(frame)`'s library (and reaches), then the new code on `next(frame)`'s with every world matrix under
+ * the figure spoilt first. Every bone must match after the bone loop (before the support hand's reach) and after the
+ * reach, every node and bone matrix after the walk, and the libraries' interpolants must see the same calls.
+ */
+function run(subjects: Subject[], frames: number, next: (frame: number) => ClipLibrary, ref: (frame: number) => ClipLibrary,
+  logs: { next: number[]; ref: number[] }, label: string): void {
+  const random = Math.random;
+  let draws = 0;
+  for (let frame = 0; frame < frames; frame++) {
+    for (const s of subjects) drive(s, frame);
+    subjects.forEach((s, f) => {
+      // Both start from the bones as the last frame left them (a folded bone keeps its pose, the reach may turn it).
+      const before = s.body.bones.map(bone => [bone.position.clone(), bone.quaternion.clone(), bone.scale.clone()] as const);
+      refSync(s.body, ref(frame));
+      const expected = pose(s.body);
+      if (refReach(s.body) && s.figure.rig!.motion.aim < 1) s.partial++;
+      const reached = pose(s.body), walked = drawn(s.body);
+      s.body.bones.forEach((bone, i) => {
+        const [position, quaternion, scale] = before[i]!;
+        bone.position.copy(position);
+        bone.quaternion.copy(quaternion);
+        bone.scale.copy(scale);
+      });
+      spoil(s.body);
+      const root = s.figure.root, update = root.updateWorldMatrix;
+      const hook: { loop: number[] | null } = { loop: null };
+      // The reach starts by updating the root's world matrix: the bone loop's output is the pose then.
+      root.updateWorldMatrix = function (this: Object3D, parents: boolean, children: boolean) {
+        hook.loop ??= pose(s.body);
+        update.call(this, parents, children);
+      };
+      Math.random = () => { draws++; return random(); };
+      try {
+        s.body.sync(next(frame));
+      } finally {
+        Math.random = random;
+        root.updateWorldMatrix = update;
+      }
+      if (hook.loop) s.reached++;
+      if (s.body.bones.some(bone => bone.scale.x < 1e-3)) s.folded++;
+      for (const name of s.figure.rig!.motion.shots.keys()) shotsSeen.add(`${s.figure.rig!.motion.group}.${name}`);
+      same(hook.loop ?? pose(s.body), expected, () => `${label} frame ${frame}, ${s.kind} #${f}`);
+      same(pose(s.body), reached, () => `${label} frame ${frame}, ${s.kind} #${f} after the reach`);
+      same(drawn(s.body), walked, () => `${label} frame ${frame}, ${s.kind} #${f} drawn`);
+    });
+    same(logs.next, logs.ref, () => `${label} frame ${frame}: interpolant calls`);
+    logs.next.length = logs.ref.length = 0;
+  }
+  expect(draws, 'sync draws no random numbers (makes no three object)').toBe(0);
+}
+
+async function scenario(lod: OperatorLod, frames: number): Promise<void> {
+  const assets = new OperatorAssets(loaders);
+  const subjects: Subject[] = [];
+  try {
+    assets.want({ lod, size: lod === 0 ? 1024 : 512 });
+    await stream(assets);
+    const next = assets.clips!;
+    // The reference's own library from the same glb: its interpolants (their cached keys) see only its calls.
+    const gltf = await loaders.model(OPERATOR_GLB[lod]);
+    const ref = new ClipLibrary(gltf.animations, LOOP_NAMES), next2 = new ClipLibrary(gltf.animations, LOOP_NAMES);
+    const ref2 = new ClipLibrary(gltf.animations, LOOP_NAMES);
+    const logs = { next: [] as number[], ref: [] as number[] };
+    logEvaluates(next, logs.next);
+    logEvaluates(next2, logs.next);
+    logEvaluates(ref, logs.ref);
+    logEvaluates(ref2, logs.ref);
+    // Two figures of every kind (they share their kind's binding), each on its own script.
+    KINDS.forEach((kind, k) => { subjects.push(subject(assets, kind, 2 * k + 1), subject(assets, kind, 2 * k + 2)); });
+    // A sync without clips (the body's first, and any before the glb's clips are in) leaves the clips out.
+    for (const s of subjects) {
+      refSync(s.body, null);
+      const expected = pose(s.body);
+      s.body.sync(null);
+      same(pose(s.body), expected, () => `LOD${lod} no clips, ${s.kind}`);
+    }
+    run(subjects, frames, () => next, () => ref, logs, `LOD${lod}`);
+    // A body synced with another library (the binding is per library: made again) matches as well.
+    run(subjects, 40, frame => (frame % 2 ? next2 : next), frame => (frame % 2 ? ref2 : ref), logs, `LOD${lod} two libraries`);
+    // Coverage: every clip group, every one-shot (and the machines' shots that have no clip), the reach, folded limbs.
+    for (const group of GROUPS) expect(subjects.some(s => s.figure.rig!.motion.group === group), group).toBe(true);
+    for (const name of ONE_SHOTS) expect(shotsSeen.has(`humanoid.${name}`), `humanoid.${name} played`).toBe(true);
+    expect(shotsSeen.has('machine.fire'), 'a machine shot with no clip').toBe(true);
+    expect(subjects.filter(s => s.reached > 0).length, 'figures whose support hand reached').toBeGreaterThan(5);
+    expect(subjects.some(s => s.partial > 0), 'a reach at a weight under 1').toBe(true);
+    expect(subjects.filter(s => s.folded > 0).length, 'figures with a torn or hidden limb').toBeGreaterThan(5);
+  } finally {
+    for (const s of subjects) {
+      s.body.dispose();
+      for (const back of s.returns) back();
+      s.figure.dispose();
+    }
+    assets.clear();
+  }
+}
+
+test('the clips through bone-indexed bindings and the trimmed reach pose and draw every operator bone as before, to the bit', async () => {
+  await scenario(1, 700);
+  await scenario(0, 300);
+}, 240_000);
+
+test('a binding lists the loops, then the one-shots, in the order the clips apply', () => {
+  expect([...CLIPS]).toEqual([...LOOPS, ...ONE_SHOTS]);
+});
