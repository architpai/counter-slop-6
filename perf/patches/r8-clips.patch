+import { expect, test } from 'vitest';
+import { DataTexture, Group, MeshStandardMaterial, Quaternion, Vector3 } from 'three';
+import type { Interpolant, Object3D, Texture } from 'three';
+import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
+import { MeshoptDecoder } from 'three/addons/libs/meshopt_decoder.module.js';
+import { OPERATOR_GLB, OPERATOR_MANIFEST, OperatorAssets, OperatorBody } from '@/engine/render/operators';
+import type { OperatorLod } from '@/engine/render/operators';
+import { CLIPS, ClipLibrary, LOOPS, ONE_SHOTS, STILL } from '@/engine/render/operator-motion';
+import type { Carry, MotionInput, OperatorMotion } from '@/engine/render/operator-motion';
+import { makeFigure } from '@/engine/render/figure';
+import type { Figure } from '@/engine/render/figure';
+import { TACTICAL_MODELS } from '@/engine/render/tactical';
+import { makeModel } from '@/engine/enemies/model';
+import { TYPES } from '@/engine/enemies/types';
+import type { EnemyKind } from '@/engine/types';
+
+/**
+ * `OperatorBody.sync` reads the clips through a kind's bone-indexed binding and a per-figure list of the clips
+ * playing (Round 8 of perf/LOG.md). The reference below is the code it replaced (by-name lookups per bone and clip),
+ * kept verbatim: both must give every bone the same position, rotation and scale to the bit, from the same
+ * interpolant calls with the same times in the same order.
+ */
+
+const loaders = {
+  model: (url: string) => new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).loadAsync(url),
+  texture: async (url: string): Promise<Texture> => {
+    const texture = new DataTexture(new Uint8Array(4), 1, 1);
+    texture.name = url;
+    return texture;
+  },
+  upload: () => {},
+};
+
+async function stream(assets: OperatorAssets): Promise<void> {
+  for (let i = 0; i < 3000; i++) {
+    assets.pump();
+    if (!assets.pending) return;
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  throw new Error('timed out waiting for the operators to stream');
+}
+
+const LOOP_NAMES = new Set(Object.entries(OPERATOR_MANIFEST.clips).filter(([, clip]) => clip.loop).map(([name]) => name));
+const GROUPS = ['humanoid', 'machine', 'drone'] as const;
+
+// ---- The reference: OperatorMotion.delta and OperatorBody.sync's bone loop as they were at 3763490. ----
+
+const _refSample = new Quaternion(), _refIdentity = new Quaternion(), _refQ = new Quaternion(), _refUp = new Vector3(0, 1, 0);
+function refSample(track: Interpolant, t: number, weight: number): Quaternion {
+  const v = track.evaluate(t);
+  _refSample.set(v[0]!, v[1]!, v[2]!, v[3]!);
+  return weight >= 0.999 ? _refSample : _refSample.slerp(_refIdentity, 1 - weight);
+}
+
+function refDelta(motion: OperatorMotion, library: ClipLibrary, bone: string, out: Quaternion): Quaternion {
+  out.identity();
+  for (const name of LOOPS) {
+    const weight = motion.weights[name];
+    if (weight < 0.01) continue;
+    const clip = library.get(motion.group, name);
+    const track = clip?.tracks.get(bone);
+    if (!clip || !track) continue;
+    const t = name === 'idle' ? motion.idleTime % clip.duration : name === 'crouch' || name === 'aim' ? 0 : motion.cycle * clip.duration;
+    out.multiply(refSample(track, t, weight));
+  }
+  for (const name of ONE_SHOTS) {
+    const shot = motion.shots.get(name);
+    if (!shot) continue;
+    const clip = library.get(motion.group, name);
+    const track = clip?.tracks.get(bone);
+    if (!clip || !track) continue;
+    const t = name === 'melee' ? shot.t * clip.duration : Math.min(shot.t, clip.duration);
+    out.multiply(refSample(track, t, Math.min(1, shot.weight)));
+  }
+  return out;
+}
+
+function attached(part: Object3D, root: Object3D): boolean {
+  for (let node: Object3D | null = part; node; node = node.parent) if (node === root) return true;
+  return false;
+}
+
+/** The old bone loop (the support hand's reach after it is unchanged code on its output: not repeated). */
+function refSync(body: OperatorBody, clips: ClipLibrary | null): void {
+  const { rig, template } = body, motion = rig.motion;
+  for (let i = 0; i < template.bones.length; i++) {
+    const { name, position } = template.bones[i]!, bone = body.bones[i]!, source = body.sources[i];
+    if (source) {
+      if (!attached(source, rig.root) || !source.visible) {
+        bone.scale.setScalar(1e-4);
+        continue;
+      }
+      bone.position.copy(source.position);
+      bone.quaternion.copy(source.quaternion);
+      bone.scale.copy(source.scale);
+    } else {
+      bone.position.copy(position);
+      bone.quaternion.identity();
+      bone.scale.setScalar(1);
+    }
+    if (name.includes('-rotor')) {
+      bone.quaternion.multiply(_refQ.setFromAxisAngle(_refUp, name.endsWith('F') === name.includes('wingL') ? motion.spin : -motion.spin));
+    } else if (clips && motion.group !== 'drone') {
+      bone.quaternion.multiply(refDelta(motion, clips, name, _refQ));
+    }
+  }
+}
+
+// ---- Harness. ----
+
+/** Every bone's position, rotation and scale, as numbers. */
+function pose(body: OperatorBody): number[] {
+  const out: number[] = [];
+  for (const bone of body.bones) {
+    out.push(bone.position.x, bone.position.y, bone.position.z, bone.quaternion.x, bone.quaternion.y, bone.quaternion.z, bone.quaternion.w,
+      bone.scale.x, bone.scale.y, bone.scale.z);
+  }
+  return out;
+}
+
+/** The same numbers to the bit (Object.is: -0 is not +0). */
+function same(a: readonly number[], b: readonly number[], what: () => string): void {
+  if (a.length !== b.length) throw new Error(`${what()}: ${a.length} values vs ${b.length}`);
+  for (let i = 0; i < a.length; i++) {
+    if (!Object.is(a[i], b[i])) throw new Error(`${what()}: value ${i} is ${a[i]} (new) vs ${b[i]} (reference)`);
+  }
+}
+
+/** Log every evaluate of a library's tracks as (track id, time); ids by `<group>.<clip>.<bone>`, shared between libraries. */
+const trackIds = new Map<string, number>();
+function logEvaluates(library: ClipLibrary, log: number[]): void {
+  for (const group of GROUPS) {
+    for (const name of CLIPS) {
+      const clip = library.get(group, name);
+      if (!clip) continue;
+      for (const [bone, track] of clip.tracks) {
+        const key = `${group}.${name}.${bone}`;
+        if (!trackIds.has(key)) trackIds.set(key, trackIds.size);
+        const id = trackIds.get(key)!, evaluate = track.evaluate.bind(track);
+        track.evaluate = (t: number) => {
+          log.push(id, t);
+          return evaluate(t);
+        };
+      }
+    }
+  }
+}
+
+function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+const KINDS = Object.keys(TACTICAL_MODELS) as (keyof typeof TACTICAL_MODELS)[];
+const CARRIES: Carry[] = ['long', 'pistol', 'blade', 'none'];
+
+function figureOf(kind: string): Figure {
+  if (kind === 'player') return makeFigure({ kind: 'humanoid', tactical: 'player', color: 0x4c7dff, weapon: 'r4c', bodyWidth: 1, limbR: 0.033, hat: 'cap' });
+  const stats = TYPES[kind as EnemyKind];
+  const { figure } = makeModel(stats);
+  figure.root.scale.setScalar(stats.scale);
+  return figure;
+}
+
+/** A figure, its operator (made here, not by the assets, so the test holds the body) and its scripted state. */
+interface Subject {
+  kind: string;
+  figure: Figure;
+  body: OperatorBody;
+  rand: () => number;
+  input: MotionInput;
+  dt: number;
+  melee: number | null;
+  /** The frame it dies from (STILL), and the frame a limb is torn off (-1: never). */
+  dies: number;
+  tears: number;
+  torn: string;
+  hidden: Object3D | null;
+  returns: (() => void)[];
+  /** What the run reached, for the coverage checks: frames with the support hand's reach, with a folded bone. */
+  reached: number;
+  folded: number;
+}
+
+/** The one-shots seen in flight on a frame a body synced. */
+const shotsSeen = new Set<string>();
+
+const material = new MeshStandardMaterial();
+
+function subject(assets: OperatorAssets, kind: string, seed: number): Subject {
+  const figure = figureOf(kind), rig = figure.rig!, template = assets.kind(rig.kind)!;
+  const body = new OperatorBody(rig, template, () => template.meshes.map(() => material));
+  const rand = mulberry32(seed);
+  const carry = CARRIES[seed % CARRIES.length]!;
+  const limbs = ['head', 'upperL', 'foreR', 'thighL', 'wingL', 'torso'].filter(name => figure.parts[name as keyof typeof figure.parts]);
+  return {
+    kind, figure, body, rand, dt: 1 / 60, melee: null, hidden: null, returns: [], reached: 0, folded: 0,
+    input: { speed: 0, phase: 0, lateral: 0, aim: 0, carry, onGround: true, crouch: false, flinch: 0, melee: null },
+    dies: seed % 3 === 0 ? 200 + (seed % 50) : -1,
+    tears: seed % 4 === 1 ? 100 + (seed % 70) : -1,
+    torn: limbs[seed % limbs.length] ?? 'head',
+  };
+}
+
+/** One step of a figure's owner: speeds, sideways motion, crouch, aim, carry, jumps, shots, reloads, hits, throws, melee, death. */
+function drive(s: Subject, frame: number): void {
+  const { rand, input, figure } = s, motion = s.figure.rig!.motion;
+  if (frame % 60 === 0) s.dt = [1 / 60, 1 / 60, 1 / 30, 1 / 144, 1 / 20][Math.floor(rand() * 5)]!;
+  if (rand() < 0.02) input.speed = [0, 0, 0.1, 0.8, 1.2, 3, 4.2, 5, 6.2, 8][Math.floor(rand() * 10)]!;
+  if (rand() < 0.02) input.lateral = [0, 0, 0.3, -0.3, 1, -1, rand() * 2 - 1][Math.floor(rand() * 7)]!;
+  if (rand() < 0.01) input.crouch = !input.crouch;
+  if (rand() < 0.02) input.aim = [0, 1, 1, 0.5, rand()][Math.floor(rand() * 5)]!;
+  if (rand() < 0.003) input.carry = CARRIES[Math.floor(rand() * 4)]!;
+  input.onGround = !(rand() < 0.01) && (input.onGround || rand() < 0.1);
+  input.phase += input.speed * s.dt * 4;
+  input.flinch = Math.max(0, input.flinch - s.dt * 3);
+  if (rand() < 0.04) motion.trigger('fire');
+  if (rand() < 0.006) motion.trigger('reload');
+  if (rand() < 0.01) { motion.trigger('hit'); input.flinch = 1; }
+  if (rand() < 0.005) motion.trigger('throw');
+  if (s.melee === null && rand() < 0.006) s.melee = 0;
+  if (s.melee !== null) {
+    s.melee += s.dt / 0.55;
+    if (s.melee > 1) s.melee = null;
+  }
+  input.melee = s.melee;
+  const dead = s.dies >= 0 && frame >= s.dies;
+  motion.update(s.dt, dead ? STILL : input);
+  // Weights and shots at the edges of the skip and slerp tests.
+  if (frame % 37 === 5) {
+    const name = LOOPS[Math.floor(rand() * LOOPS.length)]!;
+    motion.weights[name] = [0.01, 0.0099999, 1, 0.999, 0.9989, 0, -0.001, 1.2][Math.floor(rand() * 8)]!;
+    const shot = motion.shots.get(ONE_SHOTS[Math.floor(rand() * ONE_SHOTS.length)]!);
+    if (shot) shot.weight = [1.5, 1, 0.999, 0.9989, 0.5, 0.001][Math.floor(rand() * 6)]!;
+  }
+  // The pivots, as the owner turns them; one hidden for a while; a limb torn off.
+  for (const source of s.body.sources) {
+    if (!source || rand() < 0.3) continue;
+    source.rotation.set((rand() - 0.5) * 1.2, (rand() - 0.5) * 1.2, (rand() - 0.5) * 0.6);
+    if (rand() < 0.05) source.scale.setScalar(0.5 + rand());
+  }
