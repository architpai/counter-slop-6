+ * bone loop (before the support hand's reach), and the libraries' interpolants must see the same calls.
+ */
+function run(subjects: Subject[], frames: number, next: (frame: number) => ClipLibrary, ref: (frame: number) => ClipLibrary,
+  logs: { next: number[]; ref: number[] }, label: string): void {
+  const random = Math.random;
+  let draws = 0;
+  for (let frame = 0; frame < frames; frame++) {
+    for (const s of subjects) drive(s, frame);
+    const expected = subjects.map(s => {
+      refSync(s.body, ref(frame));
+      return pose(s.body);
+    });
+    subjects.forEach((s, f) => {
+      const root = s.figure.root, update = root.updateWorldMatrix;
+      const hook: { loop: number[] | null } = { loop: null };
+      // The reach starts by updating the root's world matrix: the bone loop's output is the pose then.
+      root.updateWorldMatrix = function (this: Object3D, parents: boolean, children: boolean) {
+        hook.loop ??= pose(s.body);
+        update.call(this, parents, children);
+      };
+      Math.random = () => { draws++; return random(); };
+      try {
+        s.body.sync(next(frame));
+      } finally {
+        Math.random = random;
+        root.updateWorldMatrix = update;
+      }
+      if (hook.loop) s.reached++;
+      if (s.body.bones.some(bone => bone.scale.x < 1e-3)) s.folded++;
+      for (const name of s.figure.rig!.motion.shots.keys()) shotsSeen.add(`${s.figure.rig!.motion.group}.${name}`);
+      same(hook.loop ?? pose(s.body), expected[f]!, () => `${label} frame ${frame}, ${s.kind} #${f}`);
+    });
+    same(logs.next, logs.ref, () => `${label} frame ${frame}: interpolant calls`);
+    logs.next.length = logs.ref.length = 0;
+  }
+  expect(draws, 'sync draws no random numbers (makes no three object)').toBe(0);
+}
+
+async function scenario(lod: OperatorLod, frames: number): Promise<void> {
+  const assets = new OperatorAssets(loaders);
+  const subjects: Subject[] = [];
+  try {
+    assets.want({ lod, size: lod === 0 ? 1024 : 512 });
+    await stream(assets);
+    const next = assets.clips!;
+    // The reference's own library from the same glb: its interpolants (their cached keys) see only its calls.
+    const gltf = await loaders.model(OPERATOR_GLB[lod]);
+    const ref = new ClipLibrary(gltf.animations, LOOP_NAMES), next2 = new ClipLibrary(gltf.animations, LOOP_NAMES);
+    const ref2 = new ClipLibrary(gltf.animations, LOOP_NAMES);
+    const logs = { next: [] as number[], ref: [] as number[] };
+    logEvaluates(next, logs.next);
+    logEvaluates(next2, logs.next);
+    logEvaluates(ref, logs.ref);
+    logEvaluates(ref2, logs.ref);
+    // Two figures of every kind (they share their kind's binding), each on its own script.
+    KINDS.forEach((kind, k) => { subjects.push(subject(assets, kind, 2 * k + 1), subject(assets, kind, 2 * k + 2)); });
+    // A sync without clips (the body's first, and any before the glb's clips are in) leaves the clips out.
+    for (const s of subjects) {
+      refSync(s.body, null);
+      const expected = pose(s.body);
+      s.body.sync(null);
+      same(pose(s.body), expected, () => `LOD${lod} no clips, ${s.kind}`);
+    }
+    run(subjects, frames, () => next, () => ref, logs, `LOD${lod}`);
+    // A body synced with another library (the binding is per library: made again) matches as well.
+    run(subjects, 40, frame => (frame % 2 ? next2 : next), frame => (frame % 2 ? ref2 : ref), logs, `LOD${lod} two libraries`);
+    // Coverage: every clip group, every one-shot (and the machines' shots that have no clip), the reach, folded limbs.
+    for (const group of GROUPS) expect(subjects.some(s => s.figure.rig!.motion.group === group), group).toBe(true);
+    for (const name of ONE_SHOTS) expect(shotsSeen.has(`humanoid.${name}`), `humanoid.${name} played`).toBe(true);
+    expect(shotsSeen.has('machine.fire'), 'a machine shot with no clip').toBe(true);
+    expect(subjects.some(s => s.reached > 0), 'the support hand reached on some frames').toBe(true);
+    expect(subjects.filter(s => s.folded > 0).length, 'figures with a torn or hidden limb').toBeGreaterThan(5);
+  } finally {
+    for (const s of subjects) {
+      s.body.dispose();
+      for (const back of s.returns) back();
+      s.figure.dispose();
+    }
+    assets.clear();
+  }
+}
+
+test('the clips through bone-indexed bindings pose every operator bone as the by-name lookups did, to the bit', async () => {
+  await scenario(1, 700);
+  await scenario(0, 300);
+}, 240_000);
+
+test('a binding lists the loops, then the one-shots, in the order the clips apply', () => {
+  expect([...CLIPS]).toEqual([...LOOPS, ...ONE_SHOTS]);
+});
