+  light.shadow.updateMatrices(light);
+  const frustum = light.shadow.getFrustum(), shadowCamera = light.shadow.camera;
+  const rigs = figures.map(figure => figure.rig!);
+  const before = figures.map(figure => fields(figure.root));
+  const expected = figures.map(figure => casters(figure.root));
+  // What three would draw of each caster in this pass, before the swap changes any.
+  const culled = expected.map(list => list.map(mesh => !frustum.intersectsObject(mesh)));
+  // Figures with fewer than two parts in the box are left to three (one draw or none either way).
+  const merging = culled.map(list => list.filter(out => !out).length >= 2);
+  light.shadow.map = new WebGLRenderTarget(1, 1);
+  const flats = new FlatShadows(), random = vi.spyOn(Math, 'random');
+  let parts = 0, out = 0;
+  for (let pass = 0; pass < 2; pass++) {
+    flats.swap(rigs, light, camera);
+    try {
+      expect(flats.swapped).toBe(merging.filter(Boolean).length);
+      for (const [f, figure] of figures.entries()) {
+        const list = expected[f]!, kind = figure.rig!.kind;
+        expect(list.length, kind).toBeGreaterThan(1);
+        expect(list.length, kind).toBeLessThanOrEqual(FLAT_CASTERS);
+        if (!merging[f]) {
+          expect(fields(figure.root), kind).toEqual(before[f]);
+          continue;
+        }
+        // The first part three draws carries the draw; the parts after it stop casting.
+        const at = culled[f]!.indexOf(false), carrier = list[at]!;
+        const merged = carrier.geometry, own = before[f]![before[f]!.indexOf(carrier) + 1] as BufferGeometry;
+        expect(merged, kind).not.toBe(own);
+        expect([carrier.castShadow, carrier.frustumCulled, ...list.map((mesh, k) => k === at || mesh.castShadow === k < at)], kind)
+          .toEqual([true, false, ...list.map(() => true)]);
+        // Positions bit for bit, a part index per vertex, triangles in order past the vertices before them.
+        const positions: number[] = [], part: number[] = [], corners: number[] = [];
