+          if (culled[f]![k]) out++;
+        });
+      }
+    } finally {
+      flats.restore();
+    }
+    for (const [f, figure] of figures.entries()) expect(fields(figure.root), `${figure.rig!.kind} restored`).toEqual(before[f]);
+  }
+  light.shadow.map.dispose();
+  expect(random).not.toHaveBeenCalled();
+  expect(out, 'some parts out of the box').toBeGreaterThan(0);
+  expect(parts - out, 'some parts in it').toBeGreaterThan(0);
+  expect(merging.filter(Boolean).length, 'some figures merged').toBeGreaterThan(3);
+});
+
+test('figures it cannot merge exactly are left to three', () => {
+  const scene = new Scene(), camera = new PerspectiveCamera(), light = sun(9);
+  const [lent, hidden, foreign, shown] = ['grunt', 'grunt', 'heavy', 'medic'].map(figureOf) as [Figure, Figure, Figure, Figure];
+  made.push(lent, hidden, foreign, shown);
+  scene.add(light, light.target, lent.root, hidden.root, foreign.root, shown.root);
+  lent.lend(lent.parts.weapon!);
+  hidden.root.visible = false;
+  // A caster that is not a flat surface (the debris's dropped gun) sits under the figure.
+  const gun = new Mesh(new BoxGeometry(), new MeshBasicMaterial());
+  gun.castShadow = true;
+  foreign.parts.torso!.add(gun);
+  scene.updateMatrixWorld(true);
+  light.shadow.updateMatrices(light);
+  light.shadow.map = new WebGLRenderTarget(1, 1);
