+  flats.swap(rigs, light, camera);
+  try {
+    expect(flats.swapped).toBe(1);
+    expect(casters(shown.root).filter(mesh => mesh.castShadow)).toHaveLength(1);
+    for (const figure of [lent, hidden, foreign]) expect(casters(figure.root).every(mesh => mesh.customDepthMaterial === undefined)).toBe(true);
+  } finally {
+    flats.restore();
+  }
+});
+
+test('the merged draws give the same shadow map, one draw per flat figure', () => {
+  const renderer = new WebGLRenderer({ canvas: document.createElement('canvas') });
+  renderer.shadowMap.enabled = true;
+  renderer.shadowMap.autoUpdate = false;
+  const scene = new Scene(), camera = new PerspectiveCamera(60, 1, 0.1, 100), target = new WebGLRenderTarget(16, 16);
+  camera.position.set(0, 10, 15);
+  camera.lookAt(0, 0, 0);
+  // Cut through the rows, so culled parts are in it too.
+  const light = sun(7);
+  scene.add(light, light.target);
+  scene.overrideMaterial = new MeshBasicMaterial();
+  const figures = [...KINDS.map(figureOf), figureOf('breacher')];
+  made.push(...figures);
+  figures.at(-1)!.dropShield();
+  for (const [i, figure] of figures.entries()) {
+    figure.root.position.set((i % 6) * 2.2 - 6, 0, Math.floor(i / 6) * 2.2 - 4);
+    figure.root.rotation.y = i * 0.7;
+    figure.parts.upperR?.rotation.set(-1.5, 0, 0.4);
+    figure.parts.thighL?.rotation.set(-0.8, 0, 0);
+    scene.add(figure.root);
+  }
+  const flats = new FlatShadows(), rigs = figures.map(figure => figure.rig!);
+  const drawShadows = renderer.shadowMap.render.bind(renderer.shadowMap);
+  let merge = false, calls = 0;
+  renderer.shadowMap.render = (lights, at, from) => {
+    const before = renderer.info.render.calls;
+    if (merge) flats.swap(rigs, light, from);
+    try { drawShadows(lights, at, from); } finally { flats.restore(); }
+    calls = renderer.info.render.calls - before;
+  };
