+test('on 2K textures (Ultra) a slot holds twice SLOT_BYTES; the presets below keep SLOT_BYTES', () => {
+  for (const [name, values] of Object.entries(PRESET_VALUES)) {
+    expect(slotBudget(TEXTURE_SIZE[values.textures])).toBe(name === 'ultra' ? 2 * SLOT_BYTES : SLOT_BYTES);
+  }
+  const renderer = makeRenderer();
+  let clock = 1000;
+  const now = vi.spyOn(performance, 'now').mockImplementation(() => clock);
+  cleanup.push(() => now.mockRestore());
+  const queue = (sizes: number[]) => {
+    const left = [...sizes], sent: number[] = [];
+    const pump = (limit: number) => {
+      const next = left[0];
+      if (next === undefined || next > limit) return 0;
+      left.shift();
+      sent.push(next);
+      return next;
+    };
+    return { sent, pump };
+  };
+  const slot = (frame: number, pump: (limit: number) => number) => {
+    renderer._frame = frame;
+    renderer._upload(pump);
+  };
+  renderer._uploadPace = 1;
+  renderer._uploadAt = 0;
+  // Ultra: four 1K-sized maps share a slot, and the gap after it follows its bytes (48 ms).
+  renderer._quality = PRESET_VALUES.ultra;
+  const half = SLOT_BYTES / 2, a = queue([half, half, half, half, half]);
+  slot(1, a.pump);
+  expect(a.sent.length).toBe(4);
+  expect(renderer._uploadAt).toBeCloseTo(1000 + 2 * UPLOAD_GAP_MS);
+  // A 2K map first in a slot takes in what still fits under the budget, no more.
+  const k2 = 2.8e6, b = queue([k2, 2 * SLOT_BYTES - k2, 1]);
+  clock = 2000;
+  slot(2, b.pump);
+  expect(b.sent).toEqual([k2, 2 * SLOT_BYTES - k2]);
+  // High (1K textures): two of the same maps per slot, as before.
+  renderer._quality = PRESET_VALUES.high;
+  const c = queue([half, half, half]);
+  clock = 3000;
+  slot(3, c.pump);
+  expect(c.sent.length).toBe(2);
+  expect(renderer._uploadAt).toBeCloseTo(3000 + UPLOAD_GAP_MS);
+});
