+test('the ticks sit where the spread puts them, and the contained crosshair stays a 0x0 box', () => {
+  const store = new HudStore();
+  mount(store);
+  flushSync(() => store.setGameplayVisible(true));
+  const box = q('[data-hud="crosshair"]').getBoundingClientRect();
+  store.setSpread(23.5);
+  // Settle the ticks' transitions to read their end values.
+  for (const animation of document.getAnimations()) animation.finish();
+  const at = (tick: string) => { const s = getComputedStyle(q(`.crosshair .${tick}`)); return [s.top, s.left]; };
+  expect([at('top'), at('bottom'), at('left'), at('right')])
+    .toEqual([['-35.5px', '-1.5px'], ['23.5px', '-1.5px'], ['-1.5px', '-35.5px'], ['-1.5px', '23.5px']]);
+  flushSync(() => store.setCrosshairMode('melee'));
+  for (const animation of document.getAnimations()) animation.finish();
+  expect(at('top')).toEqual(['-39.5px', '-1.5px']);
+  const after = q('[data-hud="crosshair"]').getBoundingClientRect();
+  expect([box.width, box.height, after.width, after.height, after.left, after.top]).toEqual([0, 0, 0, 0, box.left, box.top]);
+  // The ticks are placed from the crosshair's centre point.
+  const top = q('.crosshair .top').getBoundingClientRect();
+  expect([top.left - after.left, top.top - after.top, top.width, top.height]).toEqual([-1.5, -39.5, 3, 16]);
+});
+
+test('transition and animation events from the HUD stop at the window; others still reach the document', () => {
+  const store = new HudStore();
+  mount(store);
+  const seen: string[] = [];
+  const capture = (e: Event) => seen.push(`capture ${e.type}`), bubble = (e: Event) => seen.push(`bubble ${e.type}`);
+  const types = ['transitionrun', 'transitionstart', 'transitioncancel', 'transitionend'];
+  for (const type of types) { document.addEventListener(type, capture, true); document.addEventListener(type, bubble); }
+  document.addEventListener('animationiteration', bubble);
+  const outside = document.createElement('div');
+  document.body.append(outside);
+  try {
+    for (const type of types) q('.crosshair .top').dispatchEvent(new TransitionEvent(type, { bubbles: true, propertyName: 'top' }));
+    q('.crosshair .dot').dispatchEvent(new AnimationEvent('animationiteration', { bubbles: true }));
+    expect(seen).toEqual([]);
+    outside.dispatchEvent(new TransitionEvent('transitionend', { bubbles: true }));
+    expect(seen).toEqual(['capture transitionend', 'bubble transitionend']);
+    // Unmounted, the HUD no longer filters.
+    const tick = q('.crosshair .top');
+    flushSync(() => root!.unmount());
+    root = undefined;
+    seen.length = 0;
+    host!.append(tick);
+    tick.dispatchEvent(new TransitionEvent('transitionrun', { bubbles: true }));
+    expect(seen).toEqual(['capture transitionrun', 'bubble transitionrun']);
+  } finally {
+    for (const type of types) { document.removeEventListener(type, capture, true); document.removeEventListener(type, bubble); }
+    document.removeEventListener('animationiteration', bubble);
+    outside.remove();
+  }
+});
+
+test('for a run of spread, melee and ADS inputs the ticks compute the positions and classes HEAD computed', () => {
+  const store = new HudStore();
+  store.setSpread(14.04); // written before the HUD mounts: each tick replays it when it binds
+  mount(store);
+  flushSync(() => store.setGameplayVisible(true));
+  const settle = () => { for (const animation of document.getAnimations()) animation.finish(); };
+  const tick = (name: string) => { const s = getComputedStyle(q(`.crosshair .${name}`)); return [s.top, s.left, s.display]; };
+  // HEAD's values: `--spread` on the crosshair, inherited by the ticks (globals.css .crosshair rules).
+  const expected = (s: number, melee: boolean) => [
+    [`${-s - (melee ? 16 : 12)}px`, '-1.5px', 'block'], [`${s}px`, '-1.5px', 'block'],
+    ['-1.5px', `${-s - 12}px`, melee ? 'none' : 'block'], ['-1.5px', `${s}px`, melee ? 'none' : 'block'],
+  ];
+  settle();
+  expect(['top', 'bottom', 'left', 'right'].map(tick)).toEqual(expected(14, false));
+  const steps: [number, boolean, boolean][] = [[3.26, false, false], [3.26, true, false], [0, true, true], [41.95, false, true], [-5, false, false]];
+  for (const [spread, melee, ads] of steps) {
+    flushSync(() => { store.setSpread(spread); store.setCrosshairMode(melee ? 'melee' : ''); store.setAds(ads); });
+    settle();
+    const s = Number(Math.max(0, spread).toFixed(1));
+    expect(['top', 'bottom', 'left', 'right'].map(tick), `${spread} ${melee} ${ads}`).toEqual(expected(s, melee));
+    expect(q('[data-hud="crosshair"]').className).toBe(`crosshair${melee ? ' melee' : ''}${ads ? ' ads' : ''}`);
+    expect(getComputedStyle(q('[data-hud="crosshair"]')).opacity).toBe(ads ? '0' : '1');
+  }
+});
diff --git a/tests/mobile-weapon-label.test.tsx b/tests/mobile-weapon-label.test.tsx
new file mode 100644
index 0000000..4afdc97
--- /dev/null
+++ b/tests/mobile-weapon-label.test.tsx
@@ -0,0 +1,26 @@
+import { afterEach, expect, test } from 'vitest';
+import { createRoot, type Root } from 'react-dom/client';
+import { flushSync } from 'react-dom';
+import { MobileControls } from '@/components/hud/MobileControls';
+import { HudStore } from '@/engine/hud/store';
+import { TouchInput } from '@/engine/touch';
+import type { GameHandle } from '@/engine/boot';
+
+let root: Root | undefined, host: HTMLDivElement | undefined;
+afterEach(() => { flushSync(() => root?.unmount()); root = undefined; host?.remove(); host = undefined; });
+
+test('the touch weapon button shows the weapon and ammo from its own leaf, with the same markup', () => {
+  const store = new HudStore();
+  const game = { input: { touch: new TouchInput(), clearTouch() {} }, pause() {}, resume() {} } as unknown as GameHandle;
+  host = document.createElement('div'); document.body.append(host);
+  root = createRoot(host);
+  flushSync(() => root!.render(<MobileControls store={store} game={game} />));
+  const button = host.querySelector<HTMLElement>('[data-touch="weapon"]')!;
+  const markup = (name: string, mag: string, reserve: string, note: string) =>
+    `<span><strong>${name}</strong><b>${mag}<small> ${reserve}</small></b></span><small>${note}</small>`;
+  expect(button.innerHTML).toBe(markup('R4-C', '30', '/120', 'TAP TO SWITCH →'));
+  flushSync(() => store.setAmmo(29, 90, 30, false));
+  expect(button.innerHTML).toBe(markup('R4-C', '29', '/90', 'TAP TO SWITCH →'));
+  flushSync(() => { store.setAmmo(0, 90, 30, true); store.setWeapon('MP5', ''); });
+  expect(button.innerHTML).toBe(markup('MP5', '0', '/90', 'RELOADING'));
+});
